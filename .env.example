# Supabase Auth & Config (Public anon credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Judge Demo Credentials (Public demo account)
NEXT_PUBLIC_DEMO_EMAIL=judge@bob.ai
NEXT_PUBLIC_DEMO_PASSWORD=your_demo_password

# API Routing Configuration (Optional)
# In production on Vercel, requests route to same-origin /svc/api automatically.
# Set NEXT_PUBLIC_API_URL only if pointing to an external custom backend host.
# NEXT_PUBLIC_API_URL=http://localhost:8000

