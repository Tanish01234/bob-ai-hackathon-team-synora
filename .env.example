# Supabase Auth & Config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo / Judge Credentials (Low-privilege demo user)
