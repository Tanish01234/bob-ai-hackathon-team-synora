# NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here
# NEXT_PUBLIC_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
